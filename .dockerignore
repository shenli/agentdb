# Anything rebuilt inside the container — don't ship it into the
# build context.
target/
.worktrees/
test-sessions/
.codex/
.devroom/
.aws/
.env
.env.*
**/.env
**/.env.*
**/node_modules/
perf-out/
bench-out/

# Local dev state.
data/
agentdb-data/
local-backups/
restore-scratch/
*.sqlite
*.sqlite-wal
*.sqlite-shm
**/.venv/
**/__pycache__/

# IDE + git clutter.
.idea/
.vscode/
.git/

# Docs + scripts that aren't needed to compile.
docs/
scripts/
benchmarks/
workload/target/
tools/agentdb-bench/baselines/fixtures/corpus.jsonl

# Test fixtures that bloat the context but aren't compile inputs.
**/*.png
**/*.svg
