#!/usr/bin/env bash
set -euo pipefail

dnf update -y
dnf install -y git rsync jq python3 python3-pip gcc openssl-devel

cat >/home/ec2-user/agentdb.toml <<EOF
[server]
bind = "0.0.0.0:7878"
dev = false

[storage]
data_dir = "./agentdb-data"

[storage.tablet]
layout = "grouped_rocksdb"
root_dir = "./agentdb-data/tablet-stores"
tablets_per_domain = 32
max_open_domains = 16
domain_write_buffer_size_mib = 16
domain_max_write_buffers = 2
domain_parallelism = 1
domain_max_background_jobs = 1
domain_max_open_files = 128

[storage.kv]
backend = "slatedb"

[storage.content]
backend = "object_store"

[storage.object_store]
backend = "s3"
bucket = "${bucket}"
region = "${region}"
EOF

chown ec2-user:ec2-user /home/ec2-user/agentdb.toml
