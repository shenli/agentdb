#!/usr/bin/env bash
set -euo pipefail

dnf update -y
dnf install -y git rsync jq python3 python3-pip gcc openssl-devel curl

TOKEN="$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 21600' || true)"
if [[ -n "$TOKEN" ]]; then
  PRIVATE_IP="$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)"
else
  PRIVATE_IP="$(curl -fsS http://169.254.169.254/latest/meta-data/local-ipv4)"
fi

cat >/home/ec2-user/agentdb.toml <<EOF
[deployment]
mode = "${deployment_mode}"

[server]
bind = "$${PRIVATE_IP}:${http_port}"
dev = false
%{ if internal_auth_token != "" }
internal_auth_token = "${internal_auth_token}"
%{ endif }

[storage]
data_dir = "/home/ec2-user/agentdb-data"

[storage.tablet]
layout = "grouped_rocksdb"
root_dir = "/home/ec2-user/agentdb-data/tablet-stores"
tablets_per_domain = ${tablet_store_tablets_per_domain}
max_open_domains = ${tablet_store_max_open_domains}
domain_write_buffer_size_mib = ${tablet_store_domain_write_buffer_size_mib}
domain_max_write_buffers = ${tablet_store_domain_max_write_buffers}
domain_parallelism = 1
domain_max_background_jobs = ${tablet_store_domain_max_background_jobs}
domain_max_open_files = ${tablet_store_domain_max_open_files}

[storage.kv]
backend = "slatedb"

[storage.content]
backend = "object_store"

[storage.object_store]
backend = "s3"
bucket = "${bucket}"
region = "${region}"
%{ if deployment_mode == "cluster" }

[routing]
node_id = "${node_id}"
cell_id = "${cell_id}"
region = "${region}"
availability_zone = "${availability_zone}"
capacity_class = "${capacity_class}"
%{ endif }
EOF

cat >/home/ec2-user/agentdb.env <<EOF
%{ if meta_url != "" }
AGENTDB_META_BACKEND=postgres
AGENTDB_META_URL=${meta_url}
%{ endif }
EOF

chown ec2-user:ec2-user /home/ec2-user/agentdb.toml
chown ec2-user:ec2-user /home/ec2-user/agentdb.env
