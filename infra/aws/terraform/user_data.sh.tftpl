#!/usr/bin/env bash
set -euo pipefail

dnf update -y
dnf install -y git rsync jq python3 python3-pip gcc openssl-devel curl

TOKEN="$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 21600' || true)"
if [[ -n "$TOKEN" ]]; then
  PRIVATE_IP="$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)"
else
  PRIVATE_IP="$(curl -fsS http://169.254.169.254/latest/meta-data/local-ipv4)"
fi

cat >/home/ec2-user/agentdb.toml <<EOF
[deployment]
mode = "${deployment_mode}"

[server]
bind = "$${PRIVATE_IP}:${http_port}"
dev = false
%{ if internal_auth_token != "" }
internal_auth_token = "${internal_auth_token}"
%{ endif }

[storage]
data_dir = "/home/ec2-user/agentdb-data"

[storage.tablet]
layout = "grouped_rocksdb"
root_dir = "/home/ec2-user/agentdb-data/tablet-stores"
tablets_per_domain = ${tablet_store_tablets_per_domain}
max_open_domains = ${tablet_store_max_open_domains}
domain_write_buffer_size_mib = ${tablet_store_domain_write_buffer_size_mib}
domain_max_write_buffers = ${tablet_store_domain_max_write_buffers}
domain_parallelism = 1
domain_max_background_jobs = ${tablet_store_domain_max_background_jobs}
domain_max_open_files = ${tablet_store_domain_max_open_files}

[storage.kv]
backend = "slatedb"

[storage.content]
backend = "object_store"

[storage.object_store]
backend = "s3"
bucket = "${bucket}"
region = "${region}"
%{ if deployment_mode == "cluster" }

[routing]
node_id = "${node_id}"
cell_id = "${cell_id}"
region = "${region}"
availability_zone = "${availability_zone}"
capacity_class = "${capacity_class}"
%{ endif }
EOF

cat >/home/ec2-user/agentdb.env <<EOF
%{ if meta_url != "" }
AGENTDB_META_BACKEND=postgres
AGENTDB_META_URL=${meta_url}
%{ endif }
EOF

%{ if clickhouse_url != "" && clickhouse_export_tenant_id != "" }
cat >/home/ec2-user/clickhouse-export.env <<EOF
AGENTDB_URL=http://$${PRIVATE_IP}:${http_port}
CLICKHOUSE_URL=${clickhouse_url}
AGENTDB_EXPORT_TENANT_ID=${clickhouse_export_tenant_id}
AGENTDB_EXPORT_CONSUMER=${clickhouse_export_consumer}
AGENTDB_EXPORT_MODE=${clickhouse_export_mode}
AGENTDB_EXPORT_LEASE_MS=${clickhouse_export_lease_ms}
AGENTDB_EXPORT_MAX_RETRIES=${clickhouse_export_max_retries}
AGENTDB_EXPORT_RETRY_INITIAL_BACKOFF_MS=${clickhouse_export_retry_initial_backoff_ms}
EOF
%{ endif }

%{ if jsonl_export_uri != "" && jsonl_export_tenant_id != "" }
cat >/home/ec2-user/jsonl-export.env <<EOF
AGENTDB_URL=http://$${PRIVATE_IP}:${http_port}
AGENTDB_JSONL_EXPORT_TENANT_ID=${jsonl_export_tenant_id}
AGENTDB_JSONL_EXPORT_URI=${jsonl_export_uri}
AGENTDB_JSONL_EXPORT_CONSUMER=${jsonl_export_consumer}
AGENTDB_JSONL_EXPORT_INCLUDE=${jsonl_export_include}
AGENTDB_JSONL_EXPORT_LEASE_MS=${jsonl_export_lease_ms}
AGENTDB_JSONL_EXPORT_MAX_BATCHES=${jsonl_export_max_batches}
AWS_REGION=${region}
EOF
%{ endif }

chown ec2-user:ec2-user /home/ec2-user/agentdb.toml
chown ec2-user:ec2-user /home/ec2-user/agentdb.env
if [[ -f /home/ec2-user/clickhouse-export.env ]]; then
  chown ec2-user:ec2-user /home/ec2-user/clickhouse-export.env
fi
if [[ -f /home/ec2-user/jsonl-export.env ]]; then
  chown ec2-user:ec2-user /home/ec2-user/jsonl-export.env
fi
