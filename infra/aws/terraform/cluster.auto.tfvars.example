# Copy to cluster.auto.tfvars and fill in AWS/account-specific values.

aws_region = "us-west-2"
name       = "agentdb-cluster-demo"

vpc_id = "vpc-xxxxxxxx"

# Use one subnet per AZ for the first multi-AZ cluster experiment.
subnet_ids = [
  "subnet-aaaaaaaa",
  "subnet-bbbbbbbb",
  "subnet-cccccccc",
]

node_count    = 3
instance_type = "t3.small"
key_name      = "my-keypair"
ssh_cidr      = "203.0.113.10/32"
ami_id        = "ami-xxxxxxxxxxxxxxxxx"

deployment_mode    = "cluster"
cell_id            = "cell-aws-a"
capacity_class     = "stable"
internal_auth_token = "replace-with-at-least-16-random-characters"
meta_url           = "postgres://agentdb:replace-me@my-rds-endpoint:5432/agentdb"

# Default bounded grouped RocksDB layout. Keep tablets_per_domain > 1 unless
# explicitly testing high-isolation checkpoint/restore behavior.
tablet_store_tablets_per_domain           = 32
tablet_store_max_open_domains             = 16
tablet_store_domain_write_buffer_size_mib = 16
tablet_store_domain_max_write_buffers     = 2
tablet_store_domain_max_background_jobs   = 1
tablet_store_domain_max_open_files        = 128

# Optional ClickHouse observability export. Leave clickhouse_url and
# clickhouse_export_tenant_id empty until a tenant exists and ClickHouse is
# reachable from the EC2 nodes.
clickhouse_url              = ""
clickhouse_export_tenant_id = ""
clickhouse_export_consumer  = "prod-clickhouse"
clickhouse_export_mode      = "native"
clickhouse_export_lease_ms  = 30000
clickhouse_export_max_retries = 6
clickhouse_export_retry_initial_backoff_ms = 250
clickhouse_export_payload_mode = "full"
clickhouse_export_metrics_output = "/home/ec2-user/agentdb-deploy/logs/clickhouse-export-status.json"
clickhouse_export_deny_event_kinds = ""
clickhouse_export_redact_fields = ""

# Optional JSONL/S3 observability archive. Leave jsonl_export_uri and
# jsonl_export_tenant_id empty to skip exporter setup. For S3 outputs, use a
# bounded max batch count because object-store JSONL output is uploaded as a
# completed object.
jsonl_export_tenant_id   = ""
jsonl_export_uri         = ""
jsonl_export_consumer    = "prod-jsonl"
jsonl_export_include     = "events"
jsonl_export_lease_ms    = 30000
jsonl_export_max_batches = 1000
jsonl_export_payload_mode = "full"
jsonl_export_metrics_output = "/home/ec2-user/agentdb-deploy/logs/jsonl-export-status.json"
