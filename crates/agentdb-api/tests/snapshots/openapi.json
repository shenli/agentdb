{
  "openapi": "3.1.0",
  "info": {
    "title": "AgentDB REST API",
    "description": "Agent-native operational database. See docs/agent-db.md for design and docs/ARCHITECTURE.md for implementation.",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/admin/boxes": {
      "get": {
        "tags": [
          "admin"
        ],
        "operationId": "list_boxes",
        "responses": {
          "200": {
            "description": "Per-box snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BoxListItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/boxes/{id}": {
      "get": {
        "tags": [
          "admin"
        ],
        "operationId": "get_box",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Box id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoxListItem"
                }
              }
            }
          },
          "404": {
            "description": "Box not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/boxes/{id}/inject_fault": {
      "post": {
        "tags": [
          "admin"
        ],
        "operationId": "inject_fault",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InjectFaultRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InjectFaultResponse"
                }
              }
            }
          },
          "400": {
            "description": "Unknown fault kind",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Box not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/boxes/{id}/quota": {
      "post": {
        "tags": [
          "admin"
        ],
        "operationId": "set_quota",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuotaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuotaView"
                }
              }
            }
          },
          "404": {
            "description": "Box not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/boxes/{id}/webhook": {
      "post": {
        "tags": [
          "admin"
        ],
        "operationId": "set_webhook",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Box not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/hlc": {
      "get": {
        "tags": [
          "admin"
        ],
        "operationId": "get_hlc",
        "responses": {
          "200": {
            "description": "Process-global HLC status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HlcStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/nodes": {
      "get": {
        "tags": [
          "admin"
        ],
        "operationId": "list_nodes",
        "parameters": [
          {
            "name": "stale_threshold_ms",
            "in": "query",
            "description": "Nodes whose last heartbeat is older than this many milliseconds\nare flagged `is_stale = true`. Default 15000.",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Every registered node, ordered by node_id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NodeView"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Control plane not configured on this process",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodesUnavailable"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/sessions/{session_id}": {
      "get": {
        "tags": [
          "admin"
        ],
        "operationId": "get_session",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "description": "External session id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenant_id",
            "in": "query",
            "description": "Tenant that owns the session",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDetail"
                }
              }
            }
          },
          "404": {
            "description": "Tenant or session not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/tablets": {
      "get": {
        "tags": [
          "admin"
        ],
        "operationId": "list_tablets",
        "responses": {
          "200": {
            "description": "Every tablet row, ordered by tablet_id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TabletView"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Control plane not configured on this process",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TabletsUnavailable"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/tier/force": {
      "post": {
        "tags": [
          "admin"
        ],
        "operationId": "force_tier",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForceTierRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Session transitioned to target tier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForceTierResponse"
                }
              }
            }
          },
          "400": {
            "description": "Unsupported target tier or malformed body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Tenant or session not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}/fork": {
      "post": {
        "tags": [
          "primitives"
        ],
        "operationId": "fork_handler",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "description": "Parent session's external id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Child session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForkResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Parent tenant/session not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/stream": {
      "get": {
        "tags": [
          "stream"
        ],
        "operationId": "sse_handler",
        "responses": {
          "200": {
            "description": "Server-Sent Events stream of StreamEvent payloads. OpenAPI does not model event streams well; see the StreamEvent schema for the shape of each emitted event."
          }
        }
      }
    },
    "/api/tenants/{tenant_id}/sessions/{session_id}/append_and_fetch": {
      "post": {
        "tags": [
          "primitives"
        ],
        "operationId": "append_and_fetch",
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "description": "External tenant id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "session_id",
            "in": "path",
            "description": "External session id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppendAndFetchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Event appended; last N events returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppendAndFetchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Fault injected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppendAndFetchRequest": {
        "type": "object",
        "required": [
          "event"
        ],
        "properties": {
          "actor_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional agent identifier to attribute this event to. See\n`docs/agent-db-v2.md` §2.3 for the agent-as-metadata stance —\nfree-form string, no pre-registration, no separate resource."
          },
          "event": {},
          "fetch_last_n": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "AppendAndFetchResponse": {
        "type": "object",
        "required": [
          "seq",
          "recent"
        ],
        "properties": {
          "recent": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventDto"
            }
          },
          "seq": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "BoxListItem": {
        "type": "object",
        "required": [
          "id",
          "num_tenants",
          "metrics",
          "quota",
          "fault_active"
        ],
        "properties": {
          "fault_active": {
            "type": "boolean"
          },
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "metrics": {
            "$ref": "#/components/schemas/MetricsSnapshot"
          },
          "num_tenants": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "quota": {
            "$ref": "#/components/schemas/QuotaView"
          },
          "webhook_url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "Stable machine-readable error codes.",
        "enum": [
          "not_found",
          "invalid_request",
          "quota_exceeded",
          "fault_injected",
          "storage_error",
          "serialization_error",
          "lease_lost"
        ]
      },
      "ErrorKind": {
        "type": "string",
        "enum": [
          "invalid_request_error",
          "rate_limit_error",
          "api_error"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "The JSON body we emit for every REST error. Always carries\n`code`, `type`, `message`; typed extras per code are flat fields.",
        "required": [
          "code",
          "type",
          "message"
        ],
        "properties": {
          "box_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "fault_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "resource": {
            "type": [
              "string",
              "null"
            ]
          },
          "retry_after_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "$ref": "#/components/schemas/ErrorKind"
          }
        }
      },
      "Event": {
        "type": "object",
        "description": "An append-only record inside a session.",
        "required": [
          "seq",
          "ts",
          "hlc_ts",
          "payload"
        ],
        "properties": {
          "actor_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Free-form identifier of the agent that wrote this event. Optional\n— not every event is agent-attributable (system events, user\nedits, etc.). Indexed at the tablet level for cross-session\nretrieval (\"all events for agent X\"). See `agent-db-v2.md` §2.3.\n\nAgent is a metadata dimension, not a first-class resource: no\nregistration, no quota, no lifecycle. Promoting this to a full\nresource is deferred to v2+ per §10.4."
          },
          "hlc_ts": {
            "$ref": "#/components/schemas/HlcTimestamp",
            "description": "Hybrid logical clock timestamp assigned under the session lock at\nappend time. Gives causality-respecting order across sessions and\ntablets. See `agent-db-v2.md` §4 and `hlc.rs`."
          },
          "payload": {
            "$ref": "#/components/schemas/Value"
          },
          "seq": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "ts": {
            "type": "integer",
            "format": "int64",
            "description": "Unix epoch millis at write time.",
            "minimum": 0
          }
        }
      },
      "EventDto": {
        "type": "object",
        "required": [
          "seq",
          "ts",
          "payload"
        ],
        "properties": {
          "actor_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Agent attribution, if any. Mirrors `Event::actor_id`."
          },
          "payload": {},
          "seq": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "ts": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ForceTierRequest": {
        "type": "object",
        "required": [
          "tenant_id",
          "session_id",
          "target"
        ],
        "properties": {
          "session_id": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          }
        }
      },
      "ForceTierResponse": {
        "type": "object",
        "required": [
          "tier"
        ],
        "properties": {
          "tier": {
            "type": "string"
          }
        }
      },
      "ForkRef": {
        "type": "object",
        "description": "Reference to a parent session in a fork relationship.",
        "required": [
          "parent_session_internal_id",
          "parent_seq_at_fork"
        ],
        "properties": {
          "parent_seq_at_fork": {
            "type": "integer",
            "format": "int64",
            "description": "Parent's `next_seq` at the moment of fork. The child sees parent events\nwith `seq < parent_seq_at_fork`.",
            "minimum": 0
          },
          "parent_session_internal_id": {
            "type": "integer",
            "format": "int64",
            "description": "Parent session's *internal* id (same tenant, same box as the child).",
            "minimum": 0
          }
        }
      },
      "ForkRequest": {
        "type": "object",
        "required": [
          "tenant_id",
          "new_session_id"
        ],
        "properties": {
          "new_session_id": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          }
        }
      },
      "ForkResponse": {
        "type": "object",
        "required": [
          "new_session_id",
          "parent_session_id",
          "parent_seq_at_fork"
        ],
        "properties": {
          "new_session_id": {
            "type": "string"
          },
          "parent_seq_at_fork": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "parent_session_id": {
            "type": "string"
          }
        }
      },
      "GaugeSnapshot": {
        "type": "object",
        "required": [
          "warm_sessions",
          "cold_sessions",
          "archive_sessions"
        ],
        "properties": {
          "archive_sessions": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "cold_sessions": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "warm_sessions": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "HlcStatus": {
        "type": "object",
        "description": "Process-global HLC health snapshot, served from `GET /api/admin/hlc`.",
        "required": [
          "physical_ns",
          "logical",
          "wall_clock_ns",
          "offset_ns",
          "max_offset_secs",
          "rejects"
        ],
        "properties": {
          "logical": {
            "type": "integer",
            "format": "int32",
            "description": "Current HLC logical counter.",
            "minimum": 0
          },
          "max_offset_secs": {
            "type": "integer",
            "format": "int64",
            "description": "Configured max-offset window in seconds. Inbound timestamps\nwhose physical component exceeds `wall + max_offset` are rejected\nand counted in `rejects`.",
            "minimum": 0
          },
          "offset_ns": {
            "type": "integer",
            "format": "int64",
            "description": "`physical_ns - wall_clock_ns`. Positive when HLC is ahead of wall\n(pushed by peers); negative when wall has jumped ahead and HLC\nhas not yet caught up. Absolute value > a few seconds warrants\ninvestigation."
          },
          "physical_ns": {
            "type": "integer",
            "format": "int64",
            "description": "Current HLC physical component (nanoseconds since UNIX epoch).",
            "minimum": 0
          },
          "rejects": {
            "type": "integer",
            "format": "int64",
            "description": "Running count of inbound timestamps rejected by the max-offset\nguard. Any non-zero value is a signal; a sustained growth rate\nindicates a clock-skew problem or a rogue peer.",
            "minimum": 0
          },
          "wall_clock_ns": {
            "type": "integer",
            "format": "int64",
            "description": "Local wall clock at the time of this snapshot, nanoseconds since\nepoch. Compare against `physical_ns` to estimate `offset_ns`.",
            "minimum": 0
          }
        }
      },
      "HlcTimestamp": {
        "type": "object",
        "description": "A hybrid logical clock timestamp.\n\nEncoded as 12 bytes on the wire: an 8-byte physical component\n(nanoseconds since UNIX epoch) and a 4-byte logical counter that breaks\nties when the physical component does not advance between events.",
        "required": [
          "physical_ns",
          "logical"
        ],
        "properties": {
          "logical": {
            "type": "integer",
            "format": "int32",
            "description": "Tie-breaker counter. Incremented when two events land in the same\nphysical nanosecond.",
            "minimum": 0
          },
