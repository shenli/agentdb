[Unit]
Description=AgentDB nightly local CI with cluster chaos
Wants=agentdb-local-ci-dashboard.service

[Service]
Type=oneshot
WorkingDirectory=%h/work/agentdb-nightly
Environment=PATH=%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=LOCAL_CI_RUN_ROOT=%h/agentdb-ci-runs
Environment=LOCAL_CI_NIGHTLY_CHAOS_ITERATIONS=48
Environment=LOCAL_CI_KEEP_RUNS=30
ExecStart=%h/work/agentdb-nightly/ops/local-ci/scripts/local-ci-nightly.sh
