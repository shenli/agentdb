# Environment for ops/observability/agentdb-export-clickhouse.service.
#
# Install as /etc/agentdb/agentdb-export-clickhouse.env or point the systemd
# unit at a deployment-specific env file.

AGENTDB_URL=http://127.0.0.1:7878
CLICKHOUSE_URL=http://agentdb:agentdb@127.0.0.1:8123/?database=agentdb

AGENTDB_EXPORT_TENANT_ID=ten_...
# The consumer name is the client-side checkpoint key. The exporter persists
# its resume cursor to the `agentdb_export_checkpoints` ClickHouse table keyed
# by (consumer, tenant_id); run one exporter per (consumer, tenant).
AGENTDB_EXPORT_CONSUMER=prod-clickhouse

# Use native,otel when HyperDX/ClickStack should read AgentDB's OTel views.
AGENTDB_EXPORT_MODE=native,otel
AGENTDB_EXPORT_INCLUDE=events

AGENTDB_EXPORT_LIMIT=1000
AGENTDB_EXPORT_POLL_INTERVAL_MS=1000
AGENTDB_EXPORT_MAX_RETRIES=6
AGENTDB_EXPORT_RETRY_INITIAL_BACKOFF_MS=250
AGENTDB_EXPORT_PAYLOAD_MODE=full
AGENTDB_EXPORT_METRICS_OUTPUT=/var/lib/agentdb/clickhouse-export-status.json

# The packaged systemd unit runs with --backfill --tail. Leaving backfill
# enabled is safe; the client-side checkpoint cursor prevents replaying already
# exported batches after a restart.
AGENTDB_EXPORT_BACKFILL=1

# Optional privacy gates are supported by agentdbctl:
#   --allow-object-type events,records
#   --deny-event-kind debug
#   --redact-field data.payload.secret
# Add those flags directly to the systemd unit or deployment wrapper when a
# cluster requires exporter-side suppression before data leaves the node.
